# Copy to .env and fill in locally. .env is git-ignored; never commit real values.
# The pipeline itself needs no secrets. These are only read by optional tooling.

# Optional: override the data root (defaults to <repo>/data)
# XPTS_DATA_DIR=/absolute/path/to/data

# Optional: Postgres connection for scripts/legacy/load_db_stage_to_postgres.py (future backend)
# DATABASE_URL=postgresql://user:password@localhost:5432/xpoints
